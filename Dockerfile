# Generated by https://smithery.ai. See: https://smithery.ai/docs/config#dockerfile
# Start with a base image with Python and uv pre-installed
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS uv

# Set the working directory
WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy the cache instead of linking since it's a mounted volume
ENV UV_LINK_MODE=copy

# Copy the project files to the container
COPY . /app

# Install project dependencies using the lockfile
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-dev --no-editable

# Finally, install the project itself
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

# Use a lightweight Python image for production
FROM python:3.12-slim-bookworm

WORKDIR /app

# Copy the installed package and dependencies from the uv stage
COPY --from=uv /root/.local /root/.local
COPY --from=uv --chown=app:app /app/.venv /app/.venv

# Set the environment path
ENV PATH="/app/.venv/bin:$PATH"

# Define the entry point for the container
ENTRYPOINT ["mcp-dice"]
